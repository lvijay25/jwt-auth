<!DOCTYPE module PUBLIC "-//Puppy Crawl//DTD Check Configuration 1.3//EN"
        "http://www.puppycrawl.com/dtds/configuration_1_3.dtd">
    <!-- Enforces UTF-8 encoding -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <!-- Sets the default severity for all checks in the file -->
    <property name="severity" value="warning"/>

    <module name="TreeWalker">
        <!-- Ensures no star imports are used -->
        <module name="AvoidStarImport"/>

        <!-- Ensures no empty blocks of code -->
        <module name="EmptyBlock"/>

        <!-- Customizes the 'MethodLength' check to flag methods over 60 lines -->
        <module name="MethodLength">
            <property name="max" value="60"/>
        </module>

        <!-- Example of using a regex for a specific rule -->
        <module name="IllegalTokenText">
            <property name="tokens" value="STRING_LITERAL"/>
            <property name="format" value="abc|xyz"/> <!-- Flags literal strings containing 'abc' or 'xyz' -->
            <property name="ignoreCase" value="true"/>
        </module>
        <!-- Left curly on next line -->
        <module name="LeftCurly">
            <property name="option" value="nl"/>
        </module>
        <!-- Right curly on next line -->
        <module name="RightCurly">
            <property name="option" value="alone"/>
        </module>
    </module>
    <!-- Checks that all packages have package documentation -->
    <module name="JavadocPackage"/>
</module>

